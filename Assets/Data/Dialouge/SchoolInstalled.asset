  m_Script: {fileID: 11500000, guid: a4abce92d2f04c46950ccacf447658a7, type: 3}
  m_Name: SchoolInstalled
  m_EditorClassIdentifier: 
  dialogueId: "\uD559\uAD50 \uAC74\uC124"
  cutsceneBefore: {fileID: 0}
  lines:
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uAF2C\uB9C8\uAC00 \uD560 \uB9D0\uC774 \uC788\uB2E4\uACE0 \uD569\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uB9C8\uC744 \uAF2C\uB9C8"
    portrait: {fileID: 21300000, guid: 27d7e8099909fac4c93a97b7917fba69, type: 3}
    side: 2
    text: "\uC544\uC800\uC528 \uC548\uB155\uD558\uC138\uC694"
    easyText: 
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    side: 0
    text: "\uC624\uB79C\uB9CC\uC774\uB124\n\uBB34\uC2A8 \uC77C\uC774\uB2C8?"
    easyText: 
  - speaker: "\uB9C8\uC744 \uAF2C\uB9C8"
    portrait: {fileID: 21300000, guid: 27d7e8099909fac4c93a97b7917fba69, type: 3}
    side: 2
    text: "\uD559\uAD50 \uC9C0\uC5B4\uC8FC\uC2E0\uAC70 \uC544\uC800\uC528 \uB9DE\uC8E0?"
    easyText: 
  - speaker: "\uB9C8\uC744 \uAF2C\uB9C8"
    portrait: {fileID: 21300000, guid: 27d7e8099909fac4c93a97b7917fba69, type: 3}
    side: 2
    text: "\uD559\uAD50\uAC00 \uB108\uBB34 \uBA40\uC5B4\uC11C \uAC00\uAE30 \uC2EB\uC5C8\uB294\uB370
      \uD559\uAD50\uAC00 \uC0DD\uACA8\uC11C \uB108\uBB34 \uC88B\uC544\uC694"
    easyText: 
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    side: 0
    text: "\uADF8\uB798, \uC774\uC81C \uD559\uAD50\uB3C4 \uADFC\uCC98\uB2C8\uAE50
      \uACF5\uBD80\uB3C4 \uC5F4\uC2EC\uD788 \uD558\uACE0"
    easyText: 
  - speaker: "\uB9C8\uC744 \uAF2C\uB9C8"
    portrait: {fileID: 21300000, guid: 27d7e8099909fac4c93a97b7917fba69, type: 3}
    side: 2
    text: "\uC73C....\uACF5\uBD80\uB294 \uC2EB\uC5B4\uC694"
    easyText: 
  - speaker: "\uB9C8\uC744 \uAF2C\uB9C8"
    portrait: {fileID: 21300000, guid: 27d7e8099909fac4c93a97b7917fba69, type: 3}
    side: 2
    text: "\uADF8\uB798\uB3C4 \uD559\uAD50 \uC9C0\uC5B4\uC8FC\uC154\uC11C \uAC10\uC0AC\uD558\uB2E4\uACE0
      \uC778\uC0AC\uB4DC\uB9AC\uB7EC \uC654\uC5B4\uC694"
    easyText: 
  - speaker: "\uB9C8\uC744 \uAF2C\uB9C8"
    portrait: {fileID: 21300000, guid: 27d7e8099909fac4c93a97b7917fba69, type: 3}
    side: 2
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4 \uC544\uC800\uC528"
    easyText: 
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    side: 0
    text: "\uADF8\uB798, \uC870\uC2EC\uD788 \uAC00\uB834"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uD559\uAD50\uAC00 \uC9C0\uC5B4\uC9C0\uACE0 \uC8FC\uBBFC\uB4E4\uC758 \uB9CC\uC871\uB3C4\uAC00
      \uC62C\uB790\uC2B5\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uC55E\uC73C\uB85C \uC0C8\uB85C\uC6B4 \uC774\uC8FC\uBBFC \uBD84\uB4E4\uB3C4
      \uC544\uC774\uB4E4\uC774 \uD559\uAD50\uB97C \uAC00\uC9C0 \uBABB\uD55C\uB2E4\uACE0
      \uAC71\uC815\uD558\uC9C4 \uC54A\uC744\uAC81\uB2C8\uB2E4"
    easyText: 
  pauseGame: 1
  playOnce: 1
