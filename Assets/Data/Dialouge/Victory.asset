%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a4abce92d2f04c46950ccacf447658a7, type: 3}
  m_Name: Victory
  m_EditorClassIdentifier: 
  dialogueId: Victory
  cutsceneBefore: {fileID: 0}
  lines:
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    side: 0
    text: "\uC774\uC820 \uC2AC\uC2AC \uB354 \uC9D3\uC744 \uC218 \uC788\uB294 \uC2DC\uC124\uB3C4
      \uC5C6\uB294 \uAC83 \uAC19\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uC774\uC7A5\uB2D8\uAED8\uC11C \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC500\uC774
      \uC788\uB2E4\uACE0 \uD558\uC2ED\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uC11C\uC6B8 \uC591\uBC18, \uC7A0\uAE50 \uC598\uAE30 \uAD1C\uCC2E\uC740\uAC00"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uC11C\uC6B8 \uC591\uBC18 \uB355\uBD84\uC5D0 \uC694\uC998 \uC6B0\uB9AC
      \uB9C8\uC744\uC5D0 \uD65C\uAE30\uAC00 \uB3CC\uC544"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uB9C8\uC744\uC5D0 \uC80A\uC740\uC774\uB4E4\uB3C4 \uB9CE\uC774 \uB298\uC5C8\uACE0
      \uC560\uAE30\uB4E4\uB3C4 \uB9CE\uC774 \uBCF4\uC774\uB354\uAD70"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uC694\uC998\uC740 \uC9D1\uC5D0 \uB3C4\uB451 \uB4E4 \uAC71\uC815\uB3C4
      \uC5C6\uACE0 \uB2E4\uCCD0\uB3C4 \uC758\uC0AC\uC120\uC0DD\uB2D8\uC774 \uADFC\uCC98\uC5D0
      \uACC4\uC2DC\uB2C8\uAE50 \uAC71\uC815\uC774 \uC5C6\uB124"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uC774\uAC8C \uB2E4 \uC11C\uC6B8 \uC591\uBC18 \uB355\uBD84\uC774\uB124"
    easyText: 
  - speaker: "\uC8FC\uC778\uACF5"
    portrait: {fileID: 0}
    side: 0
    text: "\uC544\uB2D9\uB2C8\uB2E4\n\uC800\uB3C4 \uB355\uBD84\uC5D0 \uB9CE\uC774
      \uBC30\uC6E0\uC2B5\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uACB8\uC190 \uC548 \uB5A8\uC5B4\uB3C4 \uB41C\uB2E4\uB124"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uCC98\uC74C\uC5D4 \uC11C\uC6B8 \uC591\uBC18\uC774 \uC6B0\uB9AC \uB9C8\uC744\uC744
      \uC790\uAE30 \uB9C8\uC74C\uB300\uB85C \uBC14\uAFC0\uB824\uB294 \uC904 \uC54C\uC558\uB294\uB370"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uC774\uB807\uAC8C \uB9C8\uC744\uC744 \uC88B\uAC8C \uB9CC\uB4E4\uC5B4
      \uC904 \uC904\uC774\uC57C"
    easyText: 
  - speaker: "\uC774\uC7A5\uB2D8"
    portrait: {fileID: 21300000, guid: b2de812db2e9d964eb548773d2eac49d, type: 3}
    side: 2
    text: "\uC55E\uC73C\uB85C\uB3C4 \uC6B0\uB9AC \uB9C8\uC744\uC744 \uBD80\uD0C1\uD55C\uB2E4\uB124"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uB2F9\uC2E0\uC758 \uB178\uB825 \uB355\uBD84\uC5D0 \uB354 \uC0B4\uAE30
      \uC88B\uC740 \uB9C8\uC744\uC774 \uB418\uC5C8\uC2B5\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740 \uB2F9\uC2E0\uC774 \uC9C0\uC740
      \uC2DC\uC124\uB4E4\uC744 \uB9CC\uC871\uC2A4\uB7FD\uAC8C \uC0AC\uC6A9\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uB2E4\uCE5C \uC0AC\uB78C\uC774 \uC788\uB354\uB77C\uB3C4 \uC81C\uB54C
      \uCE58\uB8CC\uB97C \uBC1B\uC744 \uC218 \uC788\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uBC94\uC8C4\uAC00 \uC77C\uC5B4\uB098\uBA74 \uBC14\uB85C \uCD9C\uB3D9\uD560
      \uC218 \uC788\uB294 \uACBD\uCC30\uC774 \uC788\uC2B5\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uBD88\uC774 \uB098\uB3C4 \uC804\uBD80 \uD0C0\uAE30\uC804\uC5D0 \uC18C\uBC29\uAD00\uC774
      \uBA3C\uC800 \uB3C4\uCC29\uD569\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uC544\uC774\uB4E4\uC774 \uD559\uAD50\uB97C \uAC00\uAE30 \uC704\uD574
      \uC0C8\uBCBD\uBD80\uD130 \uC900\uBE44 \uD558\uC9C0 \uC54A\uC544\uB3C4 \uB429\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uB2F9\uC2E0\uC758 \uB178\uB825\uC73C\uB85C \uC774 \uBAA8\uB4E0\uAC8C
      \uAC00\uB2A5\uD574\uC84C\uC2B5\uB2C8\uB2E4"
    easyText: 
  - speaker: "\uBE44\uC11C"
    portrait: {fileID: 0}
    side: 2
    text: "\uAD7F \uC5D4\uB529\n\uD301 - \uBAA8\uB450\uB97C \uC704\uD574 \uB178\uB825
      \uD574\uC900 \uB2F9\uC2E0\uAED8 \uAC10\uC0AC\uB4DC\uB9BD\uB2C8\uB2E4"
    easyText: 
  pauseGame: 1
  playOnce: 1
